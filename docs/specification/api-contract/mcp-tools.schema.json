{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Kairos MCP Tools 清单结构契约",
  "description": "mcp-tools.json 的 JSON Schema（D-428 补全产物；2026-08-13 全面审计 P2-4 修复——此前 CI 引用的 schema 文件不存在，ajv 校验从未真实生效，仅 JSON 合法性降级检查）",
  "type": "object",
  "required": ["$schema", "title", "description", "version", "toolCount", "tools"],
  "properties": {
    "$schema": { "type": "string" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "version": { "type": "string" },
    "toolCount": { "type": "integer", "minimum": 1 },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "description", "mapsTo", "inputSchema"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "description": { "type": "string" },
          "mapsTo": { "type": "string", "minLength": 1 },
          "inputSchema": { "type": "object" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
